{
 "datasets": [
  {
   "name": "ds_kpi",
   "displayName": "KPIs",
   "queryLines": [
    "SELECT SUM(chamados) AS chamados, ROUND(SUM(chamados)*100000.0/SUM(populacao),1) AS por_100mil, COUNT(*) AS distritos FROM workspace.gs.ouro_mvp_mapa"
   ]
  },
  {
   "name": "ds_zona",
   "displayName": "Centro x Periferia",
   "queryLines": [
    "SELECT zona, SUM(chamados) AS chamados, ROUND(SUM(chamados)*100000.0/SUM(populacao),1) AS chamados_por_100mil_hab FROM workspace.gs.ouro_mvp_mapa GROUP BY zona"
   ]
  },
  {
   "name": "ds_top",
   "displayName": "Top 15 distritos",
   "queryLines": [
    "SELECT distrito, zona, chamados, chamados_por_100mil_hab FROM workspace.gs.ouro_mvp_mapa ORDER BY chamados_por_100mil_hab DESC LIMIT 15"
   ]
  },
  {
   "name": "ds_mapa",
   "displayName": "ouro_mvp_mapa",
   "queryLines": [
    "SELECT distrito, zona, populacao, chamados, chamados_por_100mil_hab, tempo_medio_dias, pct_finalizado, lat, lon FROM workspace.gs.ouro_mvp_mapa"
   ]
  }
 ],
 "pages": [
  {
   "name": "pagina_indicadores",
   "displayName": "Indicadores",
   "layout": [
    {
     "widget": {
      "name": "w_titulo",
      "multilineTextboxSpec": {
       "lines": [
        "## Vésper — Indicadores da Ouro\n",
        "Chamados de **poste e fiação** do SP156 (jul–set/2026) por distrito, com população do IBGE 2022. Fonte: `workspace.gs.ouro_mvp_mapa` (agregada por distrito, sem dado pessoal)."
       ]
      }
     },
     "position": {
      "x": 0,
      "y": 0,
      "width": 6,
      "height": 2
     }
    },
    {
     "widget": {
      "name": "w_kpi_total",
