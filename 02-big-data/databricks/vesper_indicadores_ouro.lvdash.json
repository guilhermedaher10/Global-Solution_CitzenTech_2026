         "fields": [
          {
           "name": "chamados",
           "expression": "`chamados`"
          }
         ],
         "disaggregated": true
        }
       }
      ],
      "spec": {
       "version": 2,
       "widgetType": "counter",
       "encodings": {
        "value": {
         "fieldName": "chamados",
         "displayName": "Chamados de poste/fiação"
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Chamados de poste/fiação"
