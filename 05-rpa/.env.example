# Copie para .env (que NAO vai para o GitHub) e ajuste.

# mock   = grava o e-mail como .eml em outbox/emails (padrao, seguro para demo)
# smtp   = envia e-mail de verdade (use uma caixa de TESTE, nunca a prefeitura real)
# portal = grava outbox/fila_portal.csv para o UiPath preencher o portal
ENVIO_MODO=mock

DESTINO_EMAIL=zeladoria@example.org
REMETENTE=robo@example.org

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_SENHA=

LIMIAR_CONFIANCA=0.70
JANELA_DUPLICIDADE_DIAS=30
MAX_TENTATIVAS=3
BACKOFF_BASE_S=1.0

# URL do webhook do n8n (deixe vazio para desativar a notificacao)
N8N_WEBHOOK_URL=
